# Lotus Capital Frontend Environment Configuration
# Never put API secrets or passwords in the frontend!

# Backend Base URL (leave empty in development if using Vite's dev proxy)
VITE_API_BASE_URL=http://localhost:8000

# Application Environment: 'development' | 'staging' | 'production'
VITE_APP_ENV=development

# Show unconfirmed/pending statistics with visual warning markers in dev mode
VITE_SHOW_PENDING_STATS=true

