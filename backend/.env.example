# Database Configuration
# For local SQLite development/testing: sqlite:///./lotus_capital.db
# For production PostgreSQL: postgresql://lotus_user:lotus_password@localhost:5432/lotus_capital_db
DATABASE_URL=sqlite:///./lotus_capital.db

# Security & JWT Tokens
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# SMTP / Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=notifications@lotuscapital.in
ENQUIRY_NOTIFICATION_EMAIL=admin@lotuscapital.in
MOCK_EMAIL=true

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Lotus Capital API"
APP_VERSION="1.0.0"

