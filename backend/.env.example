# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Lotus Capital API"
APP_VERSION="1.0.0"

# Database Configuration
# Local SQLite development/testing: sqlite:///./lotus_capital.db
# Production PostgreSQL: postgresql://lotus_user:lotus_password@localhost:5432/lotus_capital_db
DATABASE_URL=sqlite:///./lotus_capital.db

# Security & JWT Tokens
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bootstrap Super Admin (seeded on first startup)
BOOTSTRAP_ADMIN_EMAIL=admin@lotuscapital.in
BOOTSTRAP_ADMIN_PASSWORD=LotusAdmin@2026
BOOTSTRAP_ADMIN_NAME=Lotus Super Admin

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Static Data & Upload Directories (optional overrides)
CONTENT_DATA_DIR=./content/data
CONTENT_PAGES_DIR=./content/pages
UPLOAD_DIR=./uploads

# SMTP / Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=notifications@lotuscapital.in
NOTIFICATION_EMAIL_FROM=notifications@lotuscapital.in
ENQUIRY_NOTIFICATION_EMAIL=admin@lotuscapital.in
NOTIFICATION_EMAIL_TO=admin@lotuscapital.in
MOCK_EMAIL=true
